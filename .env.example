# ShopSimulator and OpenAI-compatible model services
SHOPSIM_BASE_URL=http://127.0.0.1:5700
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
SERVED_MODEL_NAME=shopping-agent

# Teacher sampling only: export in the shell; scripts do not auto-load .env.
# Cleaning is offline and needs none of these variables.
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=deepseek-v4-flash

# Optional launcher overrides; export these in the shell running the scripts.
# Model lookup defaults to the models directory beside the repository.
# MODEL_ROOT=/path/to/models
# PYTHON_BIN=/path/to/env/bin/python

# Evaluation console output (export in the shell running baseline/evaluate).
# EVAL_PROGRESS_INTERVAL=15
# EVAL_ROLLOUT_PRINT_EVERY=5
